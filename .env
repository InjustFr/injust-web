# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> app ###
ACCOUNTS_URL=https://accounts.mossyleaf.studio
OIDC_CLIENT_ID=injust
OIDC_CLIENT_SECRET=
OIDC_REQUIRED_GROUP=injust
OIDC_AUTHORIZE_URL=${ACCOUNTS_URL}/application/o/authorize/
OIDC_TOKEN_URL=${ACCOUNTS_URL}/application/o/token/
OIDC_USERINFO_URL=${ACCOUNTS_URL}/application/o/userinfo/
OIDC_LOGOUT_URL=${ACCOUNTS_URL}/application/o/injust/end-session/
###< app ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://app:app@database:5432/app?serverVersion=18&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
MAILER_DSN=null://null
MAILER_SENDER="Injust <noreply@injustmusic.com>"
###< symfony/mailer ###

###> symfony/lock ###
LOCK_DSN=flock
###< symfony/lock ###

###> stripe ###
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
###< stripe ###
