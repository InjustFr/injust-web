{% extends 'base.html.twig' %}

{% set locale = app.request.locale %}
{% set locales = constant('App\\Presentation\\LocaleListener::LOCALES') %}
{% set route = app.request.attributes.get('_route') %}
{% set params = app.request.attributes.get('_route_params') %}
{% set alternates = {} %}
{% for code in locales %}
    {% set alternates = alternates|merge({(code): url(route, params|merge({_locale: code}))}) %}
{% endfor %}
{% set other = locale == 'fr' ? 'en' : 'fr' %}
{% set site_title = settings.seoTitle.in(locale) ?: brand %}
{% set site_description = settings.seoDescription.in(locale) ?: 'site.description'|trans %}
{% set indexable = settings.searchIndexing and not hidden_from_visitors %}
{% set current_section = section ?? null %}

{% block lang %}{{ locale }}{% endblock %}

{% block head %}
    {% set home = url('home') %}
    {% set title = page_title is defined ? page_title ~ ' | ' ~ brand : site_title %}
    <title>{{ title }}</title>
    <meta name="description" content="{{ site_description }}">
    <meta name="theme-color" content="#0b0d10">
    <meta name="color-scheme" content="dark">
    <meta name="robots" content="{{ indexable ? 'index, follow, max-image-preview:large' : 'noindex, nofollow' }}">
    <link rel="canonical" href="{{ alternates[locale] }}">
    {% for code, href in alternates %}
        <link rel="alternate" hreflang="{{ code }}" href="{{ href }}">
    {% endfor %}
    <link rel="alternate" hreflang="x-default" href="{{ alternates.en }}">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ brand }}">
    <meta property="og:locale" content="{{ locale == 'fr' ? 'fr_FR' : 'en_GB' }}">
    <meta property="og:title" content="{{ title }}">
    <meta property="og:description" content="{{ site_description }}">
    <meta property="og:url" content="{{ alternates[locale] }}">
    {% set share_image = og_image ?? settings.heroImage %}
    {% set band_photo = band_image ?? settings.heroImage %}
    {% set band = {'@type': 'MusicGroup', '@id': home ~ '#band', name: brand, url: home, genre: brand_genres} %}
    {% if band_photo %}
        {% set band = band|merge({image: url('media_image', {file: band_photo ~ '.webp'})}) %}
    {% endif %}
    {% if (band_same_as ?? []) is not empty %}
        {% set band = band|merge({sameAs: band_same_as}) %}
    {% endif %}
    {% if share_image %}
        <meta property="og:image" content="{{ url('media_image', {file: share_image ~ '.webp'}) }}">
        <meta name="twitter:card" content="summary_large_image">
    {% else %}
        <meta name="twitter:card" content="summary">
    {% endif %}
    <script type="application/ld+json">{{ {
        '@context': 'https://schema.org',
        '@graph': [
            band,
            {'@type': 'WebSite', '@id': home ~ '#website', url: home, name: brand, inLanguage: locale, publisher: {'@id': home ~ '#band'}},
        ]|merge(music_graph ?? []),
    }|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE'))|raw }}</script>
    {% block preload %}{% endblock %}
{% endblock %}

{% block stylesheets %}{{ vite_entry_link_tags('site') }}{% endblock %}
{% block javascripts %}{{ vite_entry_script_tags('site') }}{% endblock %}

{% block body %}
    <a class="skip-link" href="#content">{{ 'site.skip'|trans }}</a>
    {% if hidden_from_visitors %}
        <div class="hidden-banner" role="status">
            <strong>{{ 'site.hidden.title'|trans }}</strong>
            <span>{{ 'site.hidden.detail'|trans }}</span>
        </div>
    {% endif %}
    <header class="site-header">
        <a class="wordmark" href="{{ path('home') }}" aria-label="{{ 'site.home'|trans }}">
            {%- if settings.logoImage -%}
                <img src="{{ path('media_image', {file: settings.logoImage ~ '.webp'}) }}" alt="{{ brand }}">
            {%- else -%}
                {{ brand|upper }}
            {%- endif -%}
        </a>
        <nav class="site-nav" aria-label="{{ 'site.nav'|trans }}">
            {% for item in settings.enabledSections() %}
                <a class="nav-section" href="{{ path('section', {section: item.value}) }}"{% if item == current_section %} aria-current="page"{% endif %}>{{ ('site.sections.' ~ item.value)|trans }}</a>
            {% endfor %}
            <a class="lang-switch" href="{{ path(route, params|merge({_locale: other})) }}" hreflang="{{ other }}" lang="{{ other }}" title="{{ 'site.switch'|trans({}, 'messages', other) }}">{{ other|upper }}</a>
        </nav>
    </header>
    <main id="content" tabindex="-1">
        {% block main %}{% endblock %}
    </main>
    <footer class="site-footer">
        {% if legal_pages is not empty %}
            <nav class="footer-legal" aria-label="{{ 'site.footer.legal'|trans }}">
                {% for kind in legal_pages %}
                    <a class="legal-link" href="{{ path('legal', {kind: kind.value}) }}">{{ ('site.legal.' ~ kind.value)|trans }}</a>
                {% endfor %}
            </nav>
        {% endif %}
        {% if settings.contactEmail %}
            <p class="footer-contact">{{ 'site.footer.contact'|trans }} <a href="mailto:{{ settings.contactEmail }}">{{ settings.contactEmail }}</a></p>
        {% endif %}
        <p class="footer-copy">© {{ 'now'|date('Y') }} {{ brand }}</p>
    </footer>
{% endblock %}
