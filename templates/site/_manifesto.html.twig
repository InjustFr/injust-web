{% import 'site/_image.html.twig' as media %}
{% set portrait = music.text.portrait %}
{% if manifesto|trim or bio|trim or portrait %}
    <section class="manifesto" id="manifesto">
        {% if manifesto|trim %}
            <div class="manifesto-text">
                {% include 'site/_section_head.html.twig' with {id: 'manifesto-title', title: 'site.music.manifesto'|trans} only %}
                <div class="manifesto-body">{{ manifesto|raw }}</div>
            </div>
        {% endif %}
        {% if bio|trim or portrait %}
            <div class="bio">
                {% if portrait %}
                    {{ media.img(portrait, brand, 'portrait') }}
                {% endif %}
                {% if bio|trim %}
                    <h2 class="bio-title">{{ 'site.music.bio'|trans }}</h2>
                    <div class="bio-body">{{ bio|raw }}</div>
                {% endif %}
            </div>
        {% endif %}
    </section>
{% endif %}
