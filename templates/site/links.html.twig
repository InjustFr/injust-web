{% extends 'site.html.twig' %}
{% import 'site/_image.html.twig' as media %}

{% set page_title = 'site.links.title'|trans %}
{% set og_image = music.featured.cover ?? null %}
{% set band_same_as = music.socialLinks|map(link => link.url) %}

{% block body %}
    <a class="skip-link" href="#content">{{ 'site.skip'|trans }}</a>
    <main class="links-page" id="content" tabindex="-1">
        <header class="links-head">
            <h1 class="links-mark">
                {%- if settings.logoImage -%}
                    {{ media.img(settings.logoImage, brand, null, 'eager') }}
                {%- else -%}
                    {{ brand|upper }}
                {%- endif -%}
            </h1>
            <p class="links-tagline">{{ music.text.tagline.in(locale) ?: 'site.description'|trans }}</p>
        </header>
        {% include 'site/_links_release.html.twig' %}
        {% if links is not empty %}
            <ul class="links-list">
                {% for link in links %}
                    <li>
                        <a class="links-button{{ link.highlighted ? ' links-button-primary' }}" href="{{ path('go', {id: link.id}) }}" rel="noopener">
                            {%- if link.icon %}{% include 'site/_links_icon.html.twig' with {network: link.icon} only %}{% endif -%}
                            <span class="links-label">{{ link.label.in(locale) }}</span>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="links-empty">{{ 'site.links.empty'|trans }}</p>
        {% endif %}
        {% if music.socialLinks is not empty %}
            <ul class="links-socials" aria-label="{{ 'site.music.links'|trans }}">
                {% for social in music.socialLinks %}
                    <li>
                        <a class="links-social" href="{{ social.url }}" rel="me noopener" aria-label="{{ social.label ?: ('site.networks.' ~ social.network)|trans }}">
                            {%- include 'site/_links_icon.html.twig' with {network: social.network} only -%}
                        </a>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </main>
    <footer class="links-footer">
        <nav class="links-more" aria-label="{{ 'site.links.more'|trans }}">
            <a href="{{ path('home') }}">{{ 'site.links.full_site'|trans }}</a>
            <a href="{{ path('contact') }}">{{ 'site.footer.contact'|trans }}</a>
            {% if constant('App\\Domain\\Settings\\LegalKind::Mentions') in legal_pages %}
                <a href="{{ path('legal', {kind: 'mentions'}) }}">{{ 'site.legal.mentions'|trans }}</a>
            {% endif %}
            <a class="links-lang" href="{{ path(route, params|merge({_locale: other})) }}" hreflang="{{ other }}" lang="{{ other }}" title="{{ 'site.switch'|trans({}, 'messages', other) }}">{{ other|upper }}</a>
        </nav>
    </footer>
{% endblock %}
