<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml" xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">
{% set locales = constant('App\\Presentation\\LocaleListener::LOCALES') %}
{% for page in pages %}
{% for locale in locales %}
  <url>
    <loc>{{ url(page.route, page.params|merge({_locale: locale})) }}</loc>
{% if page.lastmod %}
    <lastmod>{{ page.lastmod|date('c') }}</lastmod>
{% endif %}
{% for alternate in locales %}
    <xhtml:link rel="alternate" hreflang="{{ alternate }}" href="{{ url(page.route, page.params|merge({_locale: alternate})) }}"/>
{% endfor %}
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ url(page.route, page.params|merge({_locale: locales|first})) }}"/>
{% for image in page.images %}
    <image:image>
      <image:loc>{{ url('media_image', {file: image ~ '.webp'}) }}</image:loc>
    </image:image>
{% endfor %}
  </url>
{% endfor %}
{% endfor %}
</urlset>
