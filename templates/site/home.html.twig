{% extends 'site.html.twig' %}

{% set og_image = music.featured.cover ?? null %}
{% set band_image = music.text.portrait %}
{% set has_links = links is not empty or music.socialLinks is not empty %}
{% set band_same_as = music.socialLinks|map(link => link.url) %}

{% block preload %}
    {% if settings.heroImage %}
        <link rel="preload" as="image" href="{{ path('media_image', {file: settings.heroImage ~ '.webp'}) }}" fetchpriority="high">
    {% endif %}
{% endblock %}

{% block main %}
    {% include 'site/_hero.html.twig' %}
    {% include 'site/_links.html.twig' %}
    {% include 'site/_releases.html.twig' %}
    {% include 'site/_videos.html.twig' %}
    {% include 'site/_manifesto.html.twig' %}
    {% include 'site/_hooks.html.twig' %}
{% endblock %}
