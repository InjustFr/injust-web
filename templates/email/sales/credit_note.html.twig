<!doctype html>
<html lang="{{ order.locale }}">
<head><meta charset="utf-8"></head>
<body style="font-family: sans-serif; font-size: 15px; line-height: 1.5; color: #111; background: #fff;">
<p>{{ 'sales.confirmation.greeting'|trans({}, 'emails') }}</p>
<p>{{ 'sales.credit_note.refunded'|trans({amount: creditNote.amount.cents / 100, reference: order.reference}, 'emails') }}
{{ 'sales.credit_note.delay'|trans({}, 'emails') }}</p>
{% if creditNote.reason %}<p>{{ 'sales.credit_note.reason'|trans({reason: creditNote.reason}, 'emails') }}</p>{% endif %}
<p>{{ 'sales.credit_note.attachment'|trans({number: creditNote.number, invoice: creditNote.invoiceNumber}, 'emails') }}</p>
<p>-- <br>{{ 'sales.confirmation.signature'|trans({}, 'emails') }}</p>
</body>
</html>
