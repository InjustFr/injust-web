{% set dateFormat = 'sales.date_format'|trans({}, 'emails') %}
<!doctype html>
<html lang="{{ order.locale }}">
<head><meta charset="utf-8"></head>
<body style="font-family: sans-serif; font-size: 15px; line-height: 1.5; color: #111; background: #fff;">
<p>{{ 'sales.confirmation.greeting'|trans({}, 'emails') }}</p>
<p>{{ 'sales.confirmation.intro'|trans({}, 'emails') }}</p>
<ul>
    <li>{{ 'sales.confirmation.reference'|trans({reference: order.reference}, 'emails') }}</li>
    <li>{{ 'sales.confirmation.product'|trans({product: order.productLabel}, 'emails') }}</li>
    <li>{{ 'sales.confirmation.price'|trans({amount: order.price.cents / 100}, 'emails') }}</li>
    <li>{{ 'sales.confirmation.date'|trans({date: paidAt|date(dateFormat ~ ' H:i', 'Europe/Paris')}, 'emails') }}</li>
</ul>
<p>{{ 'sales.confirmation.consents'|trans({}, 'emails') }}</p>
<ul>
    {% for consent in order.consents %}
        <li>{{ 'sales.confirmation.consent'|trans({text: consent.text, date: consent.acceptedAt|date(dateFormat ~ ' H:i:s', 'Europe/Paris')}, 'emails') }}</li>
    {% endfor %}
</ul>
<p><strong>{{ 'sales.confirmation.next'|trans({}, 'emails') }}</strong><br>
{% if bookingUrl %}
    {{ 'sales.confirmation.booking'|trans({}, 'emails') }} <a href="{{ bookingUrl }}">{{ bookingUrl }}</a>
{% else %}
    {{ 'sales.confirmation.contact_soon'|trans({}, 'emails') }}
{% endif %}</p>
<p><strong>{{ 'sales.confirmation.withdrawal_title'|trans({}, 'emails') }}</strong><br>
{{ 'sales.confirmation.withdrawal'|trans({date: paidAt|date_modify('+14 days')|date(dateFormat, 'Europe/Paris')}, 'emails') }}
{{ 'sales.confirmation.pro_rata'|trans({}, 'emails') }}
{{ 'sales.confirmation.how_to_withdraw'|trans({email: contactEmail, reference: order.reference}, 'emails') }}</p>
<p>{{ 'sales.confirmation.mediator'|trans({name: mediatorName, url: mediatorUrl}, 'emails') }}</p>
<p>{{ 'sales.confirmation.attachments'|trans({}, 'emails') }}</p>
<p>-- <br>{{ 'sales.confirmation.signature'|trans({}, 'emails') }}</p>
</body>
</html>
