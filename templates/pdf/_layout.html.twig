<!doctype html>
<html lang="{% block lang %}fr{% endblock %}">
<head>
    <meta charset="utf-8">
    <title>{% block title %}{% endblock %}</title>
    <style>
        @page { margin: 18mm 16mm; }
        body { font-family: 'DejaVu Sans', sans-serif; font-size: 9.5pt; line-height: 1.4; color: #000; background: #fff; }
        h1 { font-size: 17pt; margin: 0 0 4pt; }
        h2 { font-size: 10.5pt; margin: 12pt 0 4pt; }
        p { margin: 0 0 5pt; }
        .en { font-size: 7pt; color: #444; font-weight: normal; }
        table { width: 100%; border-collapse: collapse; }
        .parties td { vertical-align: top; width: 50%; padding: 0 8pt 0 0; }
        .lines { margin-top: 16pt; }
        .lines th, .lines td { border-bottom: 0.5pt solid #000; padding: 5pt 4pt; text-align: left; vertical-align: top; }
        .lines .number { text-align: right; white-space: nowrap; }
        .lines tfoot td { border-bottom: none; font-weight: bold; }
        .mentions { margin-top: 18pt; }
        .meta { color: #333; }
    </style>
</head>
<body>
{% block body %}{% endblock %}
</body>
</html>
