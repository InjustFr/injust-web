{% extends 'pdf/_layout.html.twig' %}

{% import 'pdf/_macros.html.twig' as doc %}

{% block title %}{{ 'invoice.title'|trans({}, 'documents', 'fr') }} {{ invoice.number }}{% endblock %}

{% block body %}
    {% set paidOn = invoice.paidAt|date('d/m/Y', 'Europe/Paris') %}
    <h1>{{ doc.label('invoice.title') }} {{ invoice.number }}</h1>
    <p class="meta">
        {{ doc.label('invoice.issued_at', {date: invoice.issuedAt|date('d/m/Y', 'Europe/Paris')}) }}<br>
        {{ doc.label('invoice.order', {reference: invoice.orderReference}) }}
    </p>

    {% include 'pdf/_parties.html.twig' with {seller: invoice.seller, buyer: invoice.buyer, country: country} only %}

    <table class="lines">
        <thead>
            <tr>
                <th>{{ doc.label('invoice.description') }}</th>
                <th class="number">{{ doc.label('invoice.quantity') }}</th>
                <th class="number">{{ doc.label('invoice.unit_price') }}</th>
                <th class="number">{{ doc.label('invoice.line_total') }}</th>
            </tr>
        </thead>
        <tbody>
            {% for line in invoice.lines %}
                <tr>
                    <td>{{ line.label }}</td>
                    <td class="number">{{ line.quantity }}</td>
                    <td class="number">{{ doc.price(line.unitPrice) }}</td>
                    <td class="number">{{ doc.price(line.total) }}</td>
                </tr>
            {% endfor %}
        </tbody>
        <tfoot>
            <tr>
                <td colspan="3" class="number">{{ doc.label('invoice.total') }}</td>
                <td class="number">{{ doc.price(invoice.total) }}</td>
            </tr>
        </tfoot>
    </table>

    <div class="mentions">
        <p>{{ invoice.vatMention }}</p>
        <p>{{ doc.label('invoice.paid', {date: paidOn}) }}</p>
        <p>{{ doc.label('invoice.category') }}</p>
        {% if business %}
            <p>{{ doc.label('invoice.penalties') }}</p>
            <p>{{ doc.label('invoice.discount') }}</p>
        {% endif %}
    </div>
{% endblock %}
