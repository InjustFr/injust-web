{% extends 'site.html.twig' %}

{% set layout = site_layout() %}
{% set settings = layout.settings %}
{% set legal_pages = layout.legal_pages %}
{% set page_seo = null %}
{% set hidden_from_visitors = false %}
{% set page_title = 'site.not_found.title'|trans %}

{% block main %}
    <section class="placeholder">
        <p class="placeholder-status">404</p>
        <h1 class="placeholder-title">{{ page_title }}</h1>
        <p class="placeholder-lead">{{ 'site.not_found.detail'|trans }}</p>
        <a class="button" href="{{ path('home') }}">{{ 'site.not_found.back'|trans }}</a>
    </section>
{% endblock %}
